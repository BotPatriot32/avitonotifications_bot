# Скопируй в .env и подставь свои значения (для локального запуска).
# В GitHub Actions эти значения задаются как Secrets, файл .env там не нужен.

AVITO_CLIENT_ID=твой_client_id
AVITO_CLIENT_SECRET=твой_client_secret

TELEGRAM_BOT_TOKEN=токен_от_BotFather
TELEGRAM_CHAT_ID=твой_chat_id

# Необязательно: если знаешь числовой id аккаунта Авито, можно задать вручную
# AVITO_USER_ID=
